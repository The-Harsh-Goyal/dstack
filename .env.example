# dstack ships no cloud integrations and needs no API keys.
# Everything below is optional and only used if you set it yourself.

# Narration TTS (scripts/narrate-pipeline.mjs). Default: silent (no voice, estimated timings).
# DSTACK_TTS_PROVIDER=silent          # silent | command
# DSTACK_TTS_COMMAND=                 # local command, placeholders {text_file} {out} {voice} {speed}
# DSTACK_TTS_WPM=155                  # speaking rate used by the silent estimate

# Video review (scripts/review-video.py). Default: local checks + contact sheets only.
# DSTACK_REVIEWER=none                # none | command
# DSTACK_REVIEW_COMMAND=              # local command, placeholders {video} {prompt_file}; prints markdown

# Data / audio locations
# DSTACK_HOME=~/.dstack
# DSTACK_AUDIO_DIR=~/.dstack/audio    # bgm-<mood>.mp3 files you supply
# DSTACK_SFX_DIR=~/.dstack/audio/sfx  # <category>/<name>.mp3 files you supply
