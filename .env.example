# dstack needs no API keys by default: every provider below is off until you set it.
# Everything here is optional and only used if you set it yourself.
# Never put an API key in this file or anywhere in the repo (see SECURITY.md).

# Narration TTS (scripts/narrate-pipeline.mjs). Default: silent (no voice, estimated timings).
# DSTACK_TTS_PROVIDER=silent          # silent | command | elevenlabs
# DSTACK_TTS_COMMAND=                 # local command, placeholders {text_file} {out} {voice} {speed}
# DSTACK_TTS_WPM=155                  # speaking rate used by the silent estimate

# Music + SFX generation (scripts/gen-audio.mjs). Default: none (you supply the files).
# DSTACK_AUDIO_PROVIDER=none          # none | elevenlabs

# ElevenLabs (the only approved outside audio service; https://api.elevenlabs.io only).
# Used only when DSTACK_TTS_PROVIDER or DSTACK_AUDIO_PROVIDER is elevenlabs.
# The key comes from the environment (export it in your shell or secret manager), or from a
# file outside this repo. Do not write the key here.
# ELEVENLABS_API_KEY=                 # set in the environment only
# DSTACK_ELEVENLABS_KEY_FILE=         # e.g. ~/.config/dstack/elevenlabs.key (chmod 600, outside the repo)
# DSTACK_ELEVENLABS_VOICE=            # voice id; default JBFqnCBsd6RMkjVDRZzb ("George")
# DSTACK_ELEVENLABS_MODEL=            # TTS model; default eleven_multilingual_v2
# DSTACK_ELEVENLABS_SFX_MODEL=        # default eleven_text_to_sound_v2
# DSTACK_ELEVENLABS_MUSIC_MODEL=      # default music_v1 (Music API needs a paid plan)

# Video review (scripts/review-video.py). Default: local checks + contact sheets only.
# DSTACK_REVIEWER=none                # none | command
# DSTACK_REVIEW_COMMAND=              # local command, placeholders {video} {prompt_file}; prints markdown

# Data / audio locations
# DSTACK_HOME=~/.dstack               # also holds cache/elevenlabs/ (generated audio, never the key)
# DSTACK_AUDIO_DIR=~/.dstack/audio    # bgm-<mood>.mp3 (yours, or from gen-audio.mjs)
# DSTACK_SFX_DIR=~/.dstack/audio/sfx  # <category>/<name>.mp3 (yours, or from gen-audio.mjs)
